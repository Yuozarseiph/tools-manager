# QodeForge /fa/tools/.htaccess
# Routing and Markdown negotiation are handled by the root .htaccess.
<IfModule mod_headers.c>
<FilesMatch "\.(html|md)$">
  Header merge Vary Accept
</FilesMatch>
<Files "file-to-markdown.html">
  Header set Link "<https://qodeforge.ir/fa/tools/file-to-markdown.md>; rel=alternate; type=text/markdown"
</Files>
<Files "project-to-markdown.html">
  Header set Link "<https://qodeforge.ir/fa/tools/project-to-markdown.md>; rel=alternate; type=text/markdown"
</Files>

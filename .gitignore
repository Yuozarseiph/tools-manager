# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
*.exe
# testing
/coverage
/send
# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# auto-generated htaccess (produced by postbuild script)
.htaccess
en.htaccess
fa.htaccess

# work/temp dev scripts directory
/work/

# pdfjs and runtime assets are copied from node_modules at build time
/public/pdfjs/
/public/runtime/

# IDE and agent directories
/.claude
/.next/
